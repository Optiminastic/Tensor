/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
/env
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Local-only tooling - never goes to main.
# Admin scripts for this machine only (reset-password.mjs talks straight to the
# auth database). Untracked is not the same as safe: `git add -A` sweeps an
# untracked directory in without asking.
/scripts/

# Local-only manual queue page. The Batches page deliberately has no machine
# picker - Tensor chooses the printer - and that is right for the floor and
# wrong for testing, where the point is to put one bed on one named printer.
# Self-contained so nothing tracked imports it: main compiles without it.
/app/dashboard/\[brand\]/production/manual-queue/
